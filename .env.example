# OpenRouter API Key (Free tier models available at https://openrouter.ai/models?q=free)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Groq or OpenAI API Key
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM Provider (openrouter, groq, openai)
LLM_PROVIDER=openrouter

# Default Model ID (e.g. meta-llama/llama-3.2-3b-instruct:free or google/gemini-2.0-flash-lite-preview-02-05:free)
LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
